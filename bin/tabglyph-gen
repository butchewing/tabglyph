#!/usr/bin/env python3
"""tabglyph-gen — build zsh name->codepoint tables from installed fonts.

Reads the glyph names baked into your installed Nerd Font (and, optionally,
Font Awesome) and writes zsh associative-array tables that tabglyph sources.
No external icon metadata needed — the names come straight from the font.

Usage:
    tabglyph-gen [--nerd-font NAME_OR_PATH] [--out DIR] [--quiet]

By default it auto-detects a Nerd Font (preferring a "Propo"/proportional
variant, which looks best in title bars) and any Font Awesome fonts in your
font directories, and writes to $XDG_CACHE_HOME/tabglyph (or ~/.cache/tabglyph).

Requires: fonttools  (pip install fonttools)
"""
from __future__ import annotations
import argparse, glob, os, sys

try:
    from fontTools.ttLib import TTFont
except ImportError:
    sys.exit("tabglyph-gen: missing dependency 'fonttools'. Install with:\n"
             "    python3 -m pip install --user fonttools")

FONT_DIRS = [
    "~/Library/Fonts", "/Library/Fonts", "/System/Library/Fonts",          # macOS
    "~/.local/share/fonts", "~/.fonts", "/usr/share/fonts",                 # Linux
    "/usr/local/share/fonts",
]


def font_files() -> list[str]:
    out: list[str] = []
    for d in FONT_DIRS:
        d = os.path.expanduser(d)
        if os.path.isdir(d):
            for ext in ("ttf", "otf", "ttc"):
                out += glob.glob(os.path.join(d, "**", f"*.{ext}"), recursive=True)
    return out


def family_name(font: TTFont) -> str:
    name = font["name"]
    # Prefer typographic family (16), fall back to legacy family (1).
    for nid in (16, 1):
        rec = name.getName(nid, 3, 1) or name.getName(nid, 1, 0)
        if rec:
            return rec.toUnicode()
    return "?"


def pick_nerd_font(override: str | None) -> str:
    files = font_files()
    if override:
        # Treat as a path first, then as a substring of the filename.
        if os.path.isfile(os.path.expanduser(override)):
            return os.path.expanduser(override)
        matches = [f for f in files if override.lower() in os.path.basename(f).lower()]
        if matches:
            return _prefer_propo(matches)
        sys.exit(f"tabglyph-gen: no installed font matches '{override}'")
    nerd = [f for f in files if "nerd" in os.path.basename(f).lower()
            and f.lower().endswith((".ttf", ".otf"))]
    if not nerd:
        sys.exit("tabglyph-gen: no Nerd Font found. Install one from "
                 "https://www.nerdfonts.com and re-run, or pass --nerd-font.")
    return _prefer_propo(nerd)


def _prefer_propo(files: list[str]) -> str:
    # Proportional variants read best in title bars; then regular, then mono.
    for key in ("propo", "regular", ""):
        for f in sorted(files):
            b = os.path.basename(f).lower()
            if key in b and "italic" not in b and "bold" not in b:
                return f
    return sorted(files)[0]


def cmap_names(path: str) -> dict[int, str]:
    return TTFont(path, fontNumber=0).getBestCmap()


def build_nerd(path: str) -> dict[str, str]:
    icons: dict[str, str] = {}
    for cp, name in cmap_names(path).items():
        if name and "-" in name and not name.startswith(("uni", "u1", "glyph")):
            icons.setdefault(name, f"{cp:05x}")
    return icons


def build_fontawesome() -> dict[str, str]:
    icons: dict[str, str] = {}
    fa = sorted(f for f in font_files()
                if "awesome" in os.path.basename(f).lower()
                and f.lower().endswith((".ttf", ".otf")))
    for path in fa:
        try:
            for cp, name in cmap_names(path).items():
                if name and not name.startswith(("uni", "u1", "glyph")):
                    icons.setdefault(name, f"{cp:05x}")
        except Exception as e:  # noqa: BLE001
            print(f"  skip {os.path.basename(path)}: {e}", file=sys.stderr)
    return icons


def write_table(path: str, var: str, icons: dict[str, str], header: str) -> None:
    with open(path, "w") as f:
        f.write(f"# {header}\n# Auto-generated by tabglyph-gen — do not edit by hand.\n")
        f.write(f"typeset -gA {var}\n{var}=(\n")
        for name in sorted(icons):
            f.write(f"  {name} {icons[name]}\n")
        f.write(")\n")


def main() -> None:
    ap = argparse.ArgumentParser(description="Build tabglyph icon tables from installed fonts.")
    ap.add_argument("--nerd-font", help="Nerd Font name substring or path (default: auto-detect)")
    ap.add_argument("--out", help="output dir (default: $XDG_CACHE_HOME/tabglyph)")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    out = os.path.expanduser(args.out or os.path.join(
        os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "tabglyph"))
    os.makedirs(out, exist_ok=True)

    nf_path = pick_nerd_font(args.nerd_font)
    nf_family = family_name(TTFont(nf_path, fontNumber=0))
    nf_icons = build_nerd(nf_path)
    write_table(os.path.join(out, "nf-icons.zsh"), "NF_ICONS", nf_icons,
                f"Nerd Font icons from {nf_family} ({os.path.basename(nf_path)})")

    fa_icons = build_fontawesome()
    if fa_icons:
        write_table(os.path.join(out, "fa-icons.zsh"), "FA_ICONS", fa_icons,
                    "Font Awesome icons (window-title rendering only)")

    if not args.quiet:
        print(f"Nerd Font : {nf_family}")
        print(f"  {len(nf_icons):>6} icons -> {out}/nf-icons.zsh")
        if fa_icons:
            print(f"Font Awesome:\n  {len(fa_icons):>6} icons -> {out}/fa-icons.zsh")
        print("\nAdd this to your Ghostty config (then fully quit & reopen Ghostty):")
        print(f"    window-title-font-family = {nf_family}")


if __name__ == "__main__":
    main()
